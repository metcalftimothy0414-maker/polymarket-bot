[Unit]
Description=Polymarket paper-trading bot dashboard
After=network-online.target polymarket-bot.service
Wants=network-online.target

[Service]
Type=simple
User=polymarket-bot
WorkingDirectory=/opt/polymarket-bot
EnvironmentFile=/opt/polymarket-bot/.env
ExecStart=/opt/polymarket-bot/.venv/bin/python -m bot.cli dashboard --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
